# Jedna z možností: API klíč, nebo přihlášený Claude Code CLI (pak nech prázdné).
ANTHROPIC_API_KEY=

# Levný model stačí – harness měří trvalost, ne kvalitu odpovědí.
CLAUDE_MODEL=claude-haiku-4-5
CLAUDE_MAX_BUDGET_USD=0.50

# Auto-deny timeout schvalování; pro vícedenní scénář musí být delší než pauza.
APPROVAL_TIMEOUT_SECONDS=604800
