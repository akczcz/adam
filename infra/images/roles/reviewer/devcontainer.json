{
 "name": "role-reviewer",
 "build": {
  "dockerfile": "Dockerfile",
  "args": {
   "BASE_IMAGE": "platform/zakazka-app:p1"
  }
 },
 "remoteUser": "app",
 "containerEnv": {
  "ANTHROPIC_BASE_URL": "http://agentgateway.platform-data.svc:4100",
  "ANTHROPIC_CUSTOM_HEADERS": "x-agent-svid: ${SVID_JWT}",
  "CLAUDE_CODE_SUBPROCESS_ENV_SCRUB": "1",
  "CLAUDE_CODE_DISABLE_AUTO_MEMORY": "1",
  "CLAUDE_CODE_PROPAGATE_TRACEPARENT": "1"
 },
 "customizations": {
  "platform": {
   "role": "reviewer",
   "version": "0.1.0",
   "image": "registry.platform.internal/roles/reviewer:0.1.0"
  }
 }
}